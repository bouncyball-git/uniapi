# Run by uniapi_embed() at build time when the embed tool can't run (cross-compiling): writes
# OUTPUT, a C++ file holding every file listed in LIST (paths relative to DIRECTORY) as a byte
# array, plus an AssetTable named NAME. Uncompressed. Two regex passes over each file's hex, so
# the time grows with the size (about 3 s per megabyte), not with its square as a loop over
# small pieces of a large string would.

file(STRINGS "${LIST}" paths)
string(REPEAT "0x..," 32 line_pattern)
set(arrays "")
set(entries "")
set(index 0)
foreach(path IN LISTS paths)
    file(READ "${DIRECTORY}/${path}" hex HEX)
    file(SIZE "${DIRECTORY}/${path}" size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," body "${hex}")
    # 32 bytes per line keeps lines short for every compiler (CMake's regex has no {32}).
    string(REGEX REPLACE "(${line_pattern})" "\\1\n" body "${body}")
    # A trailing 0 keeps empty files valid C++; `size` excludes it.
    string(APPEND arrays "const unsigned char file${index}[] = {\n${body}0};\n")
    # The path goes into a C++ string literal: escape \ and " (both legal in Linux file names).
    string(REPLACE "\\" "\\\\" literal "${path}")
    string(REPLACE "\"" "\\\"" literal "${literal}")
    string(APPEND entries "    {\"${literal}\", file${index}, ${size}, 0},\n")
    math(EXPR index "${index} + 1")
endforeach()

file(WRITE "${OUTPUT}"
"// Generated by uniapi_embed() from ${DIRECTORY}. Do not edit.
#include <uniapi/assets.hpp>
#include <uniapi/uniapi.h>

namespace {
${arrays}
const uniapi::Asset kAssets[] = {
${entries}};
}  // namespace

extern const uniapi::AssetTable ${NAME} = {kAssets, sizeof(kAssets) / sizeof(kAssets[0])};

// The same table for C code (uniapi.h): UNIAPI_C_ASSETS(${NAME}) declares this.
extern \"C\" const uniapi_assets* uniapi_assets_${NAME}(void) {
    return reinterpret_cast<const uniapi_assets*>(&${NAME});
}
")
